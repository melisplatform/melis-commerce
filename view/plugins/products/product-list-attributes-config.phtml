<?php
    $selectedValues = !empty($this->formData['m_box_product_attribute_values_ids_selected']) ? (array) $this->formData['m_box_product_attribute_values_ids_selected'] : [];
?>
<div class="form-group">
	<?php foreach ($this->attrs As $val){?>
    	<div class="row">
    		<div class="col-xs-12">
    			<div class="pdc-heading clearfix">
                    <h4>
                    	<?php echo $val->atrans_name ?>
                    </h4>
                </div>
    		</div>
    		<?php foreach ($val->attr_values As $vals){?>
    			<?php $checked = in_array($vals->atval_id, $selectedValues) ? 'check' : ''; ?>
    			<div class="col-xs-4">
                	<label class="full-category-product-list-attr-config-checkbox" data-value="<?= $this->escapeHtmlAttr($vals->atval_id) ?>">
                		<?php $valCol = 'avt_v_'.$vals->atype_column_value;?>
                		<i class="fa fa-<?php echo ($checked) ? $checked.'-' : '' ?>square-o fa-lg"></i> <?php echo $vals->$valCol?>
                	</label>
        		</div>
    		<?php }?>
    	</div>
	<?php }?>
	<?php // Selected attribute values as one comma-separated field (see MelisCommercePluginListParamsTrait) ?>
	<form>
		<input type="hidden" name="m_box_product_attribute_values_ids_selected_list" value="<?= $this->escapeHtmlAttr(implode(',', $selectedValues)) ?>">
	</form>
</div>
<style>
.full-category-product-list-attr-config-checkbox {
    cursor: pointer;
    margin-left: 20px;
    font-weight: normal;
}
.full-category-product-list-attr-config-checkbox .fa-check-square-o {
    color: #72af46;
}
</style>
<script type="text/javascript">
$(function(){
    var checkboxClass = ".full-category-product-list-attr-config-checkbox";
    $(checkboxClass).on("click", function(evt){
    	$(this).find('.fa').toggleClass('fa-check-square-o fa-square-o');

    	var ids = $(checkboxClass).filter(function() {
    		return $(this).find('.fa').hasClass('fa-check-square-o');
    	}).map(function() {
    		return $(this).data('value');
    	}).get();
    	$("input[name='m_box_product_attribute_values_ids_selected_list']").val(ids.join(","));

    	evt.stopPropagation();
    	evt.preventDefault();
    });
});
</script>
