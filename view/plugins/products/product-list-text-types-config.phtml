<?php
    $form = $this->modalForm;
    $form->prepare();
    echo $this->form()->openTag($form);
    echo $this->melisFieldCollection($form);

    $selectedTypes = !empty($this->formData['m_box_product_field_type']) ? (array) $this->formData['m_box_product_field_type'] : [];
?>
<div class="form-group">
	<div class="row">
		<div class="col-xs-12">
			<div class="pdc-heading clearfix">
                <h4>
                	<?php echo $this->translate('Text types') ?>
                </h4>
            </div>
		</div>
		<?php foreach ($this->prdTextTypes As $val):?>
			<?php $checked = in_array($val['ptt_code'], $selectedTypes) ? 'check' : ''; ?>
			<div class="col-xs-4">
            	<label class="full-category-product-list-prd-txt-types-config-checkbox" data-value="<?= $this->escapeHtmlAttr($val['ptt_code']) ?>">
            		<i class="fa fa-<?php echo ($checked) ? $checked.'-' : '' ?>square-o fa-lg"></i> <?php echo $val['ptt_name']?>
            	</label>
    		</div>
		<?php endforeach;?>
	</div>
	<?php // Selected text types as one comma-separated field (see MelisCommercePluginListParamsTrait) ?>
	<input type="hidden" name="m_box_product_field_type_list" value="<?= $this->escapeHtmlAttr(implode(',', $selectedTypes)) ?>">
</div>

<?php echo $this->form()->closeTag();?>
<style>
.full-category-product-list-prd-txt-types-config-checkbox {
    cursor: pointer;
    margin-left: 20px;
    font-weight: normal;
}
.full-category-product-list-prd-txt-types-config-checkbox .fa-check-square-o {
    color: #72af46;
}
</style>
<script type="text/javascript">
    $(function(){
        var checkboxClass = ".full-category-product-list-prd-txt-types-config-checkbox";
        $(checkboxClass).on("click", function(evt){
        	$(this).find('.fa').toggleClass('fa-check-square-o fa-square-o');

        	var types = $(checkboxClass).filter(function() {
        		return $(this).find('.fa').hasClass('fa-check-square-o');
        	}).map(function() {
        		return $(this).data('value');
        	}).get();
        	$("input[name='m_box_product_field_type_list']").val(types.join(","));

        	evt.stopPropagation();
        	evt.preventDefault();
        });
    });
</script>
