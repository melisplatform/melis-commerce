    <?php if (!empty($this->loggedInName)) echo $this->escapeHtml(sprintf($this->translate('tr_meliscommerce_plugin_logged_in_as'), $this->loggedInName)); ?>
    <a class="btn btn-default btn-sm" href="<?= $this->escapeHtml($this->logoutLink) ?>"><?= $this->translate('tr_meliscommerce_plugin_logout') ?></a>
</div>
