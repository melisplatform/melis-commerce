<?php
/**
 * React page editor only (see MelisCommercePageEditor): category tree support for the plugin config tabs
 * (category-product-list-tree-config, category-tree-config, product-list-tree-config).
 *
 * - The React editor's config iframe only loads a base set of libraries: load jstree and the commerce tree
 *   scripts on demand before initializing the tree (melisCommerceCategoryTreeReady).
 * - It posts every input as one scalar per name, so the checked categories are mirrored into the
 *   <field>_list hidden input read by MelisCommercePluginListParamsTrait (melisCommerceCategoryTreeSync).
 */
?>
<script>
// Back-office translation used by the tree's node labels (absent from the page editor iframe)
window.translations = window.translations || {};
if (!window.translations.tr_meliscommerce_categories_list_tree_view_product_num) {
    window.translations.tr_meliscommerce_categories_list_tree_view_product_num = <?= json_encode($this->translate('tr_meliscommerce_categories_list_tree_view_product_num')) ?>;
}

window.melisCommerceCategoryTreeReady = window.melisCommerceCategoryTreeReady || function(callback) {
    var loaded = function() {
        return typeof $.fn.jstree === "function"
            && typeof window.commerceCategoryTree !== "undefined"
            && typeof window.catTreeConfig !== "undefined";
    };
    if (loaded()) {
        callback();
        return;
    }

    if (!$("link[href$='/jstree/dist/themes/default/style.min.css']").length) {
        $("head").append('<link rel="stylesheet" href="/MelisCommerce/assets/jstree/dist/themes/default/style.min.css">');
    }

    var scripts = [
        "/MelisCommerce/assets/jstree/dist/jstree.min.js",
        "/MelisCommerce/plugins/js/common/category-jstree.js",
        "/MelisCommerce/plugins/js/MelisCommerceCategoryTreePlugin.js"
    ];
    var next = function(i) {
        if (i >= scripts.length) {
            callback();
            return;
        }
        $.ajax({ url: scripts[i], dataType: "script", cache: true }).always(function() { next(i + 1); });
    };
    next(0);
};

window.melisCommerceCategoryTreeSync = window.melisCommerceCategoryTreeSync || function(treeId, field) {
    $("#" + treeId).on("check_node.jstree uncheck_node.jstree", function() {
        setTimeout(function() {
            var $form = $("#" + treeId + "_form"), ids = [];
            $form.find("input[name='" + field + "[]']").each(function() {
                if (ids.indexOf(this.value) === -1) ids.push(this.value);
            });
            $form.find("input[name='" + field + "_list']").val(ids.join(","));
        }, 0);
    });
};
</script>
