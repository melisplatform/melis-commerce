<?php if (!$this->success && !empty($this->message)){?>
	<div class="alert alert-danger">
		<p><?php echo $this->message;?></p>
	</div>
<?php }elseif($this->success){?>
	<div class="alert alert-success">
		<p><?php echo $this->message?></p>
	</div>
<?php }?>

<?php
    // Applied coupons can be removed, and one that is no longer valid (deactivated, expired, used up…) is reported
    // when it is dropped — it stayed applied with no way to remove it (Mantis #0011213)
    $sessionCoupons = is_array($this->coupon) ? $this->coupon : [];
    if (!empty($sessionCoupons['couponErr']) && is_string($sessionCoupons['couponErr']) && $sessionCoupons['couponErr'] !== $this->message) {
        echo '<div class="alert alert-warning"><p>' . $this->escapeHtml($sessionCoupons['couponErr']) . '</p></div>';
    }
    $applied = [];
    foreach (['generalCoupons', 'productCoupons'] as $list) {
        foreach ((array) ($sessionCoupons[$list] ?? []) as $c) {
            if (is_object($c) && !empty($c->coup_code)) { $applied[$c->coup_code] = $c; }
        }
    }
    foreach ($applied as $code => $c) {
        echo '<div class="checkout-applied-coupon">' . $this->translate('tr_meliscommerce_plugin_checkout_coupon_code') . ': <strong>' . $this->escapeHtml($code) . '</strong> '
            . '<a class="btn btn-link btn-sm" href="?' . $this->escapeHtml(http_build_query(['m_coupon_remove' => $code, 'removeCoupon' => $code])) . '">'
            . $this->translate('tr_meliscommerce_plugin_cart_remove') . '</a></div>';
    }
?>

<style>
.default-form-err-msg-plugin li{
    display: inherit;
}
</style>
<?php
    $form = $this->couponForm;
	$form->prepare();
	echo $this->form()->openTag($form); 
	
	foreach ($form->getElements() As $key => $val)
	{
	    echo '<div class="form-group">';
	    if ($val->getLabel())
	    {
	        echo $this->formLabel($val);
	    }
	    echo $this->formElement($val);
	    echo $this->formElementErrors($val, array('class' => 'default-form-err-msg-plugin text-danger'));
	    echo '</div>';
	}
    
    echo '<button type="submit" class="btn btn-default">'.$this->translate('tr_meliscommerce_general_common_submit').'</button>';
	echo $this->form()->closeTag(); 
?>